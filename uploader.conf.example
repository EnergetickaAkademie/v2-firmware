[ports]
filter_regex = ^/dev/ttyACM\d+$

[mainboard]
wifi_ssid = ssid
wifi_password = password

server_endpoint = http://enak.server.example/coreapi

board_username = board_usr
board_password = board_pwd

# Required to enable the mainboard's authenticated HTTP OTA endpoint.
# The first OTA-capable firmware must still be installed over USB.
ota_host = 192.168.1.50
ota_port = 8080
ota_password = replace-with-a-long-random-password
ota_hostname = enak-mainboard-1
firmware_version = 0.1.0
