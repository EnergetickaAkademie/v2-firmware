[ports]
filter_regex = ^/dev/ttyACM\d+$

[mainboard]
wifi_ssid = ssid
wifi_password = password

server_endpoint = http://enak.server.example/coreapi

board_username = board_usr
board_password = board_pwd
# Set false to build a board that only uses /board/sync/v2.
mqtt_v3_enabled = true

# Required to enable the mainboard's authenticated HTTP OTA endpoint.
# The first OTA-capable firmware must still be installed over USB.
ota_host = 192.168.1.50
ota_port = 8080
ota_password = replace-with-a-long-random-password
ota_hostname = enak-mainboard-1
# PEM root CA certificate trusted by the board for HTTPS API downloads.
# Required when server_endpoint uses https://.
api_ca_cert_file =
firmware_version = 0.1.0
firmware_channel = stable

# Used by “Build Firmware + Manifest”. The URL must point to the hosted binary.
firmware_download_url = https://downloads.example.com/enak/mb_firmware.bin
firmware_artifact_dir = artifacts
firmware_manifest_file = artifacts/firmware-manifest.json
firmware_notes_url =
firmware_config_schema = 1
